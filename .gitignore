# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code: the shared agent manifest and project skills are committed,
# personal settings (settings.local.json) and worktrees stay local.
# See docs/agent-setup.md.
.claude/*
!.claude/settings.json
!.claude/skills/

# Market research notes (local only)
/docs/research/

# Implementation plans kept off GitHub (local only)
/docs/plans/local/

# Floor plan illustration working folder: research notes, renders, reference
# assets. The SVGs themselves live in /public/illustrations/ and are committed.
/docs/illustration-office/

# Generated gradient PNGs from the smear-gradients experiment (regenerate with
# `node experiments/smear-gradients/smear-gradient.mjs`)
/experiments/smear-gradients/output/

# Stack best-practice reference for agents (Next 16.3.4, React 19, Tailwind v4,
# Radix, Motion, Vitest), researched 2026-09-15 against the installed versions.
# Local only: a working reference, not a repo convention — docs/components.md
# and docs/clone-conventions.md own those.
/docs/frontend-practices.md
